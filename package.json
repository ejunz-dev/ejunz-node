{
  "name": "ejunz-node",
  "packageManager": "yarn@4.2.0",
  "private": true,
  "workspaces": [
    "packages/server",
    "packages/server/node/ui"
  ],
  "scripts": {
    "dev": "node -r ./register.js packages/server/index.ts --debug --node",
    "dev:node": "yarn dev",
    "dev:ui": "yarn workspace @ejunz/agent-edge-node-ui dev:ui",
    "build:ui": "yarn workspace @ejunz/agent-edge-node-ui build:ui",
    "start": "node -r ./register.js packages/server/index.ts --node",
    "build": "yarn build:ui && node -r ./register.js build.ts",
    "build:server": "node -r ./register.js build.ts",
    "build:pkg": "yarn build:ui && node -r ./register.js build.ts && pkg dist/ejunz-node.js --targets linux,macos,win --out-path dist/pkg"
  },
  "devDependencies": {
    "@ejunz/register": "^0.3.2",
    "@ejunz/utils": "^0.4.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.19.10",
    "@yao-pkg/pkg": "^6.21.0",
    "base16384": "^1.0.0",
    "esbuild": "^0.25.9",
    "lodash": "^4.17.21",
    "postject": "^1.0.0-alpha.6",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "formidable": "patch:formidable@npm%3A2.1.2#~/.yarn/patches/formidable-npm-2.1.2-40ba18d67f.patch",
    "http-proxy@npm:^1.18.1": "patch:http-proxy@npm%3A1.18.1#~/.yarn/patches/http-proxy-npm-1.18.1-a313c479c5.patch",
    "@ejunz/utils": "^0.4.1",
    "@ejunz/register": "^0.3.2"
  }
}
