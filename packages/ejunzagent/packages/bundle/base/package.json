    "@ejunz/tool-goal": "workspace:^",
    "@ejunz/tool-jobs": "workspace:^",
    "@ejunz/tool-skill": "workspace:^",
    "@ejunz/tool-todo": "workspace:^",
    "@ejunz/tool-web": "workspace:^",
    "@ejunz/tool-workflow": "workspace:^",
