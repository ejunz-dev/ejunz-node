    "@ejunz/session-title": "workspace:^",
    "@ejunz/session-title-first-prompt-llm": "workspace:^",
    "@ejunz/settings-file": "workspace:^",
    "@ejunz/skill": "workspace:^",
    "@ejunz/skill-badge": "workspace:^",
    "@ejunz/spill-local": "workspace:^",
    "@ejunz/spill-policy": "workspace:^",
    "@ejunz/subagent": "workspace:^",
