{
  "name": "@ejunz/compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the EjunzAgent",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/commands": "workspace:^",
    "@ejunz/compaction": "workspace:^",
    "@ejunz/compaction-tool-result-pruner": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/token-meter": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ejunz/compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/agent-loop": "workspace:^",
    "@ejunz/commands": "workspace:^",
    "@ejunz/compaction": "workspace:^",
    "@ejunz/compaction-tool-result-pruner": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/cordis-plugin-include": "workspace:^",
    "@ejunz/cordis-plugin-loader": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/llm-retry": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/token-meter": "workspace:^",
    "@ejunz/tools": "workspace:^"
  }
}
