{
  "name": "@ejunz/credentials-local",
  "description": "File-backed credentials provider ($EA_HOME/.env under the live process environment) for the EjunzAgent",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/atomic-write": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/credentials": "workspace:^",
    "@ejunz/home-paths": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/launch-environment": "workspace:^"
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^",
    "chokidar": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ejunz/atomic-write": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/credentials": "workspace:^",
    "@ejunz/home-paths": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/launch-environment": "workspace:^"
  }
}
