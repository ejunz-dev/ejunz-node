{
  "name": "@ejunz/fs-local",
  "description": "Local-filesystem implementation of the EjunzAgent filesystem seam (ctx.fs)",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/fs": "workspace:^",
    "@ejunz/invariants": "workspace:^"
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/fs": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^"
  }
}
