{
  "name": "@ejunz/user-approval",
  "description": "User-approval seam (ctx.approval) for the EjunzAgent: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/brand": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/scope": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/system-prompt": "workspace:^"
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/brand": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/scope": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/system-prompt": "workspace:^"
  }
}
