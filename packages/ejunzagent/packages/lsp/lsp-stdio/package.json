{
  "name": "@ejunz/lsp-stdio",
  "description": "Generic stdio language-server provider for the EjunzAgent LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/brand": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/fs": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/lsp": "workspace:^",
    "@ejunz/subprocess": "workspace:^",
    "@ejunz/timeout": "workspace:^"
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/brand": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/fs": "workspace:^",
    "@ejunz/fs-local": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/lsp": "workspace:^",
    "@ejunz/subprocess": "workspace:^",
    "@ejunz/subprocess-local": "workspace:^",
    "@ejunz/timeout": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
