{
  "name": "@ejunz/tool-lsp",
  "description": "Model-facing lsp tool over the EjunzAgent LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/lsp": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/timeout": "workspace:^",
    "@ejunz/tools": "workspace:^"
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/fs-local": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/lsp": "workspace:^",
    "@ejunz/lsp-stdio": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/subprocess-local": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/timeout": "workspace:^",
    "@ejunz/tool-call-timeout-policy": "workspace:^",
    "@ejunz/tools": "workspace:^"
  }
}
