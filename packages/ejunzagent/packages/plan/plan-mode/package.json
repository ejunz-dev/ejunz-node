{
  "name": "@ejunz/plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/plan/plan-mode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/commands": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/session-projection": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/tools": "workspace:^",
    "@ejunz/user-questions": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ejunz/commands": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/agent-loop": "workspace:^",
    "@ejunz/commands": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/session-projection": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/tools": "workspace:^",
    "@ejunz/user-questions": "workspace:^"
  }
}
