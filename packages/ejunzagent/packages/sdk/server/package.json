{
  "name": "@ejunz/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process EjunzAgent SDK clients",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@ejunz/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/llm-deepseek": "workspace:^",
    "@ejunz/scope": "workspace:^",
    "@ejunz/sdk-protocol": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/subagent": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/agent-spine-demo": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/cordis-plugin-loader": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/llm-deepseek": "workspace:^",
    "@ejunz/scope": "workspace:^",
    "@ejunz/sdk-protocol": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/session-persistence-jsonl": "workspace:^",
    "@ejunz/subagent": "workspace:^"
  }
}
