{
  "name": "@ejunz/subagent-in-process-driver",
  "description": "Shared in-process subagent run driver: drives a child agent on ctx.agents (used by the spawn and fork backends)",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "packages/subagent/subagent-in-process-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/subagent": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/tools": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/agent": "workspace:^",
    "@ejunz/agent-loop": "workspace:^",
    "@ejunz/agent-presets": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/cordis-plugin-include": "workspace:^",
    "@ejunz/cordis-plugin-loader": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/subagent": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/tools": "workspace:^",
    "@ejunz/user-approval": "workspace:^"
  }
}
