    "@ejunz/invariants": "workspace:^",
    "@ejunz/jobs": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/scope": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/session-persistence": "workspace:^",
    "@ejunz/session-projection": "workspace:^",
    "@ejunz/session-projection-cache": "workspace:^",
    "@ejunz/tools": "workspace:^",
    "@ejunz/user-approval": "workspace:^"
  },
