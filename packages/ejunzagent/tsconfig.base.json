{
  // Doubles as the resolution facade for vite-tsconfig-paths (vitest configs
  // point here). NEVER add include/files to this file: it would leak into
  // every extending package project and narrow the facade's match-all scope.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Source-level resolution for every repo-local graph. Project references,
    // not declaration path aliases, keep each package/vendor source compiled
    // under its own tsconfig boundary.
    "paths": {
      "@ejunz/cordis": ["./vendor/cordis/src"],
      "@ejunz/cosmokit": ["./vendor/cosmokit/src"],
      "@ejunz/schemastery": ["./vendor/schemastery/src"],
      "@ejunz/cordis-plugin-loader": ["./vendor/loader/src"],
      "@ejunz/cordis-plugin-include": ["./vendor/include/src"],
      "@ejunz/cordis-plugin-group": ["./vendor/group/src"],
      "@ejunz/cordis-plugin-timer": ["./vendor/timer/src"],
      "@ejunz/cordis-plugin-hmr": ["./vendor/hmr/src"],
      "@ejunz/cordis-plugin-logger-console": ["./vendor/logger-console/src"],
      "@ejunz/invariants": ["./packages/runtime-diagnostics/invariants/src/index.ts"],
      "@ejunz/tool-call-timeout-policy": ["./packages/guard/timeout-policy/src"],
      "@ejunz/tool-call-timeout-policy/invariant": ["./packages/guard/timeout-policy/src/invariant.ts"],
      "@ejunz/typert-registry": ["./packages/typert/registry/src/index.ts"],
      "@ejunz/typert-registry/client": ["./packages/typert/registry/src/client/index.ts"],
      "@ejunz/api-gateway": ["./packages/api/gateway/src/index.ts"],
      "@ejunz/api-gateway/client": ["./packages/api/gateway/src/client/index.ts"],
      "@ejunz/api-gateway/invariant": ["./packages/api/gateway/src/invariant.ts"],
      "@ejunz/api-gateway/types": ["./packages/api/gateway/src/types.ts"],
      "@ejunz/typert-protocol": ["./packages/typert/protocol/src/index.ts"],
      "@ejunz/typert-protocol/types": ["./packages/typert/protocol/src/types.ts"],
      "@ejunz/typert-loader": ["./packages/typert/loader/src/index.ts"],
      "@ejunz/session/invariant": ["./packages/core/session/src/invariant.ts"],
      "@ejunz/typert-registry/types": ["./packages/typert/registry/src/types.ts"],
      "@ejunz/typert-generator": ["./packages/typert/generator/src/index.ts"],
      "@ejunz/session/types": ["./packages/core/session/src/types.ts"],
      "@ejunz/session/surface": ["./packages/core/session/src/surface.ts"],
      "@ejunz/session-projection/types": ["./packages/session/session-projection/src/types.ts"],
      "@ejunz/tool-todo/types": ["./packages/todo/tool-todo/src/types.ts"],
      "@ejunz/tool-todo/client": ["./packages/todo/tool-todo/src/client.ts"],
      "@ejunz/session-title/types": ["./packages/session/session-title/src/types.ts"],
      "@ejunz/session-title/client": ["./packages/session/session-title/src/client.ts"],
      "@ejunz/session-stats/types": ["./packages/session/session-stats/src/types.ts"],
      "@ejunz/session-stats/client": ["./packages/session/session-stats/src/client.ts"],
      "@ejunz/plan-mode/types": ["./packages/plan/plan-mode/src/types.ts"],
      "@ejunz/plan-mode/client": ["./packages/plan/plan-mode/src/client.ts"],
      "@ejunz/agent-presets/types": ["./packages/preset/agent-presets/src/types.ts"],
      "@ejunz/cordis-host-runner": ["./packages/extensions/cordis-host-runner/src/index.ts"],
      "@ejunz/cordis-host-runner/types": ["./packages/extensions/cordis-host-runner/src/types.ts"],
      "@ejunz/goal/types": ["./packages/goal/goal/src/types.ts"],
      "@ejunz/goal/client": ["./packages/goal/goal/src/client.ts"],
      "@ejunz/llm/types": ["./packages/llm/llm/src/types.ts"],
      "@ejunz/llm/brand": ["./packages/llm/llm/src/brand.ts"],
      "@ejunz/llm-retry/types": ["./packages/llm/llm-retry/src/types.ts"],
      "@ejunz/workflow/types": ["./packages/workflow/workflow/src/types.ts"],
      "@ejunz/tool-workflow/types": ["./packages/workflow/tool-workflow/src/types.ts"],
      "@ejunz/llm/message": ["./packages/llm/llm/src/message.ts"],
      "@ejunz/commands/brand": ["./packages/interaction/commands/src/brand.ts"],
      "@ejunz/commands/types": ["./packages/interaction/commands/src/types.ts"],
      "@ejunz/jobs/brand": ["./packages/jobs/jobs/src/brand.ts"],
      "@ejunz/credentials/types": ["./packages/credentials/credentials/src/types.ts"],
      "@ejunz/settings/types": ["./packages/settings/settings/src/types.ts"],
      "@ejunz/api-remotes/types": ["./packages/api/remotes/src/types.ts"],
      "@ejunz/api-remotes/invariant": ["./packages/api/remotes/src/invariant.ts"],
      "@ejunz/compaction/checkpoint": ["./packages/compaction/compaction/src/checkpoint.ts"],
      "@ejunz/compaction/types": ["./packages/compaction/compaction/src/types.ts"],
      "@ejunz/tools/presentation": ["./packages/core/tools/src/presentation.ts"],
      "@ejunz/tools/types": ["./packages/core/tools/src/types.ts"],
      "@ejunz/tool-subagent-control/list-agents": ["./packages/subagent/tool-subagent-control/src/list-agents.ts"],
      "@ejunz/user-approval/types": ["./packages/interaction/user-approval/src/types.ts"],
      "@ejunz/user-questions/types": ["./packages/interaction/user-questions/src/types.ts"],
      "@ejunz/agent/types": ["./packages/core/agent/src/types.ts"],
      "@ejunz/agent/brand": ["./packages/core/agent/src/brand.ts"],
      "@ejunz/agent/invariant": ["./packages/core/agent/src/invariant.ts"],
      "@ejunz/scope/invariant": ["./packages/core/scope/src/invariant.ts"],
      "@ejunz/agent-loop/invariant": ["./packages/core/agent-loop/src/invariant.ts"],
      "@ejunz/*/invariant": [
        "./packages/core/*/src/invariant.ts",
        "./packages/prompt/*/src/invariant.ts",
        "./packages/llm/*/src/invariant.ts",
        "./packages/subprocess/*/src/invariant.ts",
        "./packages/e2b/*/src/invariant.ts",
        "./packages/fs/*/src/invariant.ts",
        "./packages/skill/*/src/invariant.ts",
        "./packages/compaction/*/src/invariant.ts",
        "./packages/context/*/src/invariant.ts",
        "./packages/goal/*/src/invariant.ts",
        "./packages/feedback/*/src/invariant.ts",
        "./packages/schedule/*/src/invariant.ts",
        "./packages/guard/*/src/invariant.ts",
        "./packages/plan/*/src/invariant.ts",
        "./packages/preset/*/src/invariant.ts",
        "./packages/subagent/*/src/invariant.ts",
        "./packages/jobs/*/src/invariant.ts",
        "./packages/workflow/*/src/invariant.ts",
        "./packages/web/*/src/invariant.ts",
        "./packages/attachment/*/src/invariant.ts",
        "./packages/spill/*/src/invariant.ts",
        "./packages/todo/*/src/invariant.ts",
        "./packages/bundle/*/src/invariant.ts",
        "./packages/extensions/*/src/invariant.ts",
        "./packages/session/*/src/invariant.ts",
        "./packages/session-query/*/src/invariant.ts",
        "./packages/settings/*/src/invariant.ts",
        "./packages/credentials/*/src/invariant.ts",
        "./packages/acp/*/src/invariant.ts",
        "./packages/storage/*/src/invariant.ts",
        "./packages/sdk/*/src/invariant.ts",
        "./packages/interaction/*/src/invariant.ts",
        "./packages/boot/*/src/invariant.ts",
        "./packages/util/*/src/invariant.ts",
        "./packages/mcp/*/src/invariant.ts",
        "./packages/identity/*/src/invariant.ts",
      ],
      // host/client package names prefix the group dir (ea-client-<dir>), so
      // the generic ea-*/invariant list above cannot map them; strip the
      // group prefix with a dedicated wildcard per group instead.
      "@ejunz/host-*/invariant": ["./packages/host/*/src/invariant.ts"],
      "@ejunz/client-*/invariant": ["./packages/client/*/src/invariant.ts"],
      "@ejunz/headless/startup": ["./packages/bundle/headless/src/startup.ts"],
      "@ejunz/client-*/client": ["./packages/client/*/src/client"],
       // One wildcard maps every @ejunz/<name> to its source. Package
      // dir names are unique across groups, so first-on-disk-wins resolution is
      // unambiguous; adding a package under an existing group needs no edit
      // here. The aggregates' project references (tsconfig.host.json /
      // tsconfig.client.json) stay explicit — TS project references have no
      // wildcard form.
      "@ejunz/host-apiproxy": ["./packages/host/apiproxy/src"],
      "@ejunz/tool-host": ["./packages/ejunz/tool-host/src"],
      "@ejunz/host-apiproxy/client": ["./packages/host/apiproxy/src/fetch/client.ts"],
      "@ejunz/host-apiproxy/*": ["./packages/host/apiproxy/src/*"],
      "@ejunz/host-webserver": ["./packages/host/webserver/src"],
      "@ejunz/host-plugin-inventory": ["./packages/host/plugin-inventory/src"],
      "@ejunz/host-plugin-inventory/types": ["./packages/host/plugin-inventory/src/types.ts"],
      "@ejunz/client-connection": ["./packages/client/connection/src"],
      "@ejunz/api-remotes": ["./packages/api/remotes/src"],
      "@ejunz/api-remotes/client": ["./packages/api/remotes/src/client/index.ts"],
      "@ejunz/client-runtime": ["./packages/client/runtime/src"],
      "@ejunz/client-runtime/client": ["./packages/client/runtime/src/client"],
      // sdk/ folders are role-named without their npm-side sdk/jsonrpc prefixes,
      // so the generic wildcard cannot map these three package names.
      "@ejunz/sdk-client": ["./packages/sdk/client/src"],
      "@ejunz/sdk-protocol": ["./packages/sdk/protocol/src"],
      "@ejunz/sdk-jsonrpc-server": ["./packages/sdk/server/src"],
      "@ejunz/*": [
        "./packages/core/*/src",
        "./packages/prompt/*/src",
        "./packages/llm/*/src",
        "./packages/subprocess/*/src",
        "./packages/e2b/*/src",
        "./packages/fs/*/src",
        "./packages/lsp/*/src",
        "./packages/skill/*/src",
        "./packages/compaction/*/src",
        "./packages/context/*/src",
        "./packages/goal/*/src",
        "./packages/feedback/*/src",
        "./packages/schedule/*/src",
        "./packages/guard/*/src",
        "./packages/plan/*/src",
        "./packages/preset/*/src",
        "./packages/subagent/*/src",
        "./packages/jobs/*/src",
        "./packages/workflow/*/src",
        "./packages/web/*/src",
        "./packages/attachment/*/src",
        "./packages/spill/*/src",
        "./packages/todo/*/src",
        "./packages/bundle/*/src",
        "./packages/extensions/*/src",
        "./packages/session/*/src",
        "./packages/session-query/*/src",
        "./packages/settings/*/src",
        "./packages/credentials/*/src",
        "./packages/acp/*/src",
        "./packages/storage/*/src",
        "./packages/sdk/*/src",
        "./packages/interaction/*/src",
        "./packages/boot/*/src",
        "./packages/util/*/src",
        "./packages/mcp/*/src",
        "./packages/identity/*/src",
        "./packages/host/*/src",
        "./packages/client/*/src"
      ]
    }
  }
}
